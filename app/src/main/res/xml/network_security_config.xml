<?xml version="1.0" encoding="utf-8"?>
<!--
    base-config 默认禁止明文：内容端点、官网、播放地址实测都是 https。
    只对**上游可能下发 http 的媒体/CDN 域**开口子——视频 CDN 的 fallback 地址有时是 http，
    关死会让某些集直接播不了；接口与官网不在这些域里，仍走 https。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">fqnovel.com</domain>
        <domain includeSubdomains="true">hongguoduanju.com</domain>
        <domain includeSubdomains="true">qznovelvod.com</domain>
        <domain includeSubdomains="true">douyinvod.com</domain>
        <domain includeSubdomains="true">byteicdn.com</domain>
        <domain includeSubdomains="true">byteimg.com</domain>
    </domain-config>
</network-security-config>
